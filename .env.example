# Kakao Developers JavaScript key (not the REST API or admin key).
# Register http://localhost:3000 and your production origin as SDK domains.
NEXT_PUBLIC_KAKAO_MAP_CLIENT_KEY=

# Kakao REST API key: only the server uses this for keyword place search.
KAKAO_REST_API_KEY=

# Supabase project URL and server-only service role key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
